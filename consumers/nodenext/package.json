{
  "name": "@consumers/nodenext",
  "version": "0.0.0",
  "private": true,
  "description": "A library on nodenext resolution: every import names its .js file, #/ imports with extensions, hooks named use-*, a JavaScript configuration, no theme.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "check": "shadcn-registry check && tsc -p . && pnpm lint",
    "lint": "oxlint",
    "registry:build": "shadcn-registry build",
    "registry:test": "shadcn-registry test"
  },
  "devDependencies": {
    "@lynstack/shadcn-registry": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
