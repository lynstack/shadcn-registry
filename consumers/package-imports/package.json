{
  "name": "@consumers/package-imports",
  "version": "0.0.0",
  "private": true,
  "description": "A library also published to npm: a folder per component, #/ imports declared in package.json imports and tsconfig paths, @packageDocumentation as item descriptions, a peer the app installs, items named by URL, a style with media-query tokens and a package @import.",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "check": "shadcn-registry check && tsc -p . && pnpm lint",
    "lint": "oxlint",
    "registry:build": "shadcn-registry build",
    "registry:test": "shadcn-registry test"
  },
  "dependencies": {
    "@lynstack/class-recipe": "^1.7.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@lynstack/shadcn-registry": "workspace:*",
    "@tailwindcss/cli": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "oxlint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^19.0.0"
  }
}
